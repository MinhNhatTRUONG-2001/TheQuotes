<div class="top-row ps-2 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">THE QUOTES</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable bg-dark" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-4 py-2 text-white">
            <NavLink class="nav-link" href="/profile" Match="NavLinkMatch.All">
                <Icon Name="IconName.User" /> Profile
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
