@inject NavigationManager NavigationManager
@using Blazorise.Snackbar
@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@page "/login"

<PageTitle>Login</PageTitle>

@if (!string.IsNullOrEmpty(token))
{
    <h2>You have already logged in!</h2>
}
else
{
    <div class="mt-4 mb-2">
        <h2>Login</h2>
        <EditForm Model="User" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText id="floatingEmailOrUsername" class="form-control" placeholder="Email or Username" required
                    @bind-Value="User.Username" />
                <label for="floatingEmailOrUsername">Email or Username</label>
            </div>
            <div class="form-floating mb-3">
                <InputText id="floatingPassword" type="@(showPassword ? "text" : "password")" class="form-control"
                    placeholder="Password" required @bind-Value="User.Password" />
                <label for="floatingPassword">Password</label>
            </div>
            <Switch TValue="bool" @bind-Checked="@showPassword">Show Password</Switch>
            <div class="mb-3">
                <a href="/password-reset-request">Forgot password?</a>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@DisabledLoginButton">
                @if (DisabledLoginButton)
                {
                    <Loading />
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </EditForm>

        <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
    </div>
}

@code {
    private UserDTO User = new UserDTO();
    private SnackbarStack snackbarStack;
    private bool showPassword = false;
    private string ErrorMessage = "";
    private bool DisabledLoginButton = false;
    private string? token;
    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
    }
    protected async Task HandleLogin()
    {
        DisabledLoginButton = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/users/login", User);
            if (response.IsSuccessStatusCode)
            {
                var token = response.Content.ReadAsStringAsync().Result;
                await JS.InvokeVoidAsync("cookieManager.setCookie", "token", token, 1);
                TokenService.SetToken(token);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ErrorMessage = response.Content.ReadAsStringAsync().Result;
                await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledLoginButton = false;
        }
    }
}