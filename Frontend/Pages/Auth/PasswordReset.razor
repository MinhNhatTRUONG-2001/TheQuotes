@page "/password-reset/{token}/"
@inject NavigationManager NavigationManager
@inject HttpClient Http
@using System.Net.Http.Json
@inject IJSRuntime JS

<PageTitle>Password Reset</PageTitle>

    <div class="mt-4 mb-2">
        <h3>Password Reset</h3>
        <EditForm Model="User" OnValidSubmit="HandlePasswordReset">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText id="floatingPassword" type="@(showPassword ? "text" : "password")" class="form-control"
                    placeholder="Password" required @bind-Value="User.Password" />
                <label for="floatingPassword">Password</label>
            </div>
            <div class="form-floating mb-3">
                <InputText id="floatingRetypePassword" type="@(showPassword ? "text" : "password")" class="form-control"
                    placeholder="Retype Password" required @bind-Value="User.RetypePassword" />
                <label for="floatingRetypePassword">Retype Password</label>
            </div>
            <Switch TValue="bool" @bind-Checked="@showPassword">Show Password</Switch>
            <strong>Password rule:</strong>
            <ul>
                <li>Between 8-64 characters</li>
                <li>At least one lowercase letter</li>
                <li>At least one uppercase letter</li>
                <li>At least one digit</li>
                <li>At least one special letter</li>
            </ul>
            <button type="submit" class="btn btn-primary" disabled=@DisabledUpdateButton>
                @if (DisabledUpdateButton)
                {
                    <Loading />
                }
                else
                {
                    <span>Update</span>
                }
            </button>
        </EditForm>
        <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
    </div>

@code {
    [Parameter]
    public string? Token { get; set; }
    private UserDTO User = new UserDTO();
    private SnackbarStack snackbarStack;
    private bool showPassword = false;
    private string SuccessMessage = "";
    private string ErrorMessage = "";
    private bool DisabledUpdateButton = false;
    
    private async Task HandlePasswordReset()
    {
        DisabledUpdateButton = true;
        try
        {
            if (User.Password != User.RetypePassword)
            {
                await snackbarStack.PushAsync("Passwords do not match!", SnackbarColor.Danger);
            }
            else
            {
                var response = await Http.PutAsJsonAsync($"users/password_reset/{Token}", User);
                if (response.IsSuccessStatusCode)
                {
                    SuccessMessage = response.Content.ReadAsStringAsync().Result;
                    await snackbarStack.PushAsync(SuccessMessage, SnackbarColor.Success);
                }
                else
                {
                    ErrorMessage = response.Content.ReadAsStringAsync().Result;
                    await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
                }
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledUpdateButton = false;
        }
    }
}