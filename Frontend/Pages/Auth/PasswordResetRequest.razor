@inject NavigationManager NavigationManager
@using Blazorise.Snackbar
@inject HttpClient Http
@inject IJSRuntime JS

@page "/password-reset-request"

<PageTitle>Password Reset Request</PageTitle>

@if (!string.IsNullOrEmpty(token))
{
    <h2>You need to logout before sending password resetting request!</h2>
}
else
{
    <div class="mt-4 mb-2">
        <Button Color="Color.Primary" Type="ButtonType.Link" To="/login">
            <Icon Name="IconName.AngleLeft" /> Login
        </Button>
        <h2>Password Reset Request</h2>
        <EditForm Model="User" OnValidSubmit="HandlePasswordResetRequest">
            <DataAnnotationsValidator />
            <div class="mb-3">Please write the email associated with your account that the password needs resetting.</div>
            <div class="form-floating mb-3">
                <InputText id="floatingEmail" class="form-control" type="email" placeholder="Email" required
                    @bind-Value="User.Email" />
                <label for="floatingEmail">Email</label>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@DisabledSendRequestButton">
                @if (DisabledSendRequestButton)
                {
                    <Loading />
                }
                else
                {
                    <span>Send</span>
                }
            </button>
        </EditForm>

        <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
    </div>
}

@code {
    private UserDTO User = new UserDTO();
    private SnackbarStack snackbarStack;
    private bool showPassword = false;
    private string SuccessMessage = "";
    private string ErrorMessage = "";
    private bool DisabledSendRequestButton = false;
    private string? token;
    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
    }
    protected async Task HandlePasswordResetRequest()
    {
        DisabledSendRequestButton = true;
        try
        {
            var response = await Http.PostAsJsonAsync("users/password_reset_request", User);
            if (response.IsSuccessStatusCode)
            {
                SuccessMessage = response.Content.ReadAsStringAsync().Result;
                await snackbarStack.PushAsync(SuccessMessage, SnackbarColor.Success);
            }
            else
            {
                ErrorMessage = response.Content.ReadAsStringAsync().Result;
                await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledSendRequestButton = false;
        }
    }
}