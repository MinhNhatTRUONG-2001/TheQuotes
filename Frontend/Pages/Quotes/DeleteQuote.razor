@page "/my-quotes/delete/{id:int}"

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Delete Quote</PageTitle>

@if (string.IsNullOrEmpty(token))
{
    <h2>You need to login to delete your quotes!</h2>
}
else
{
    <div class="mt-4 mb-2">
        <Button Color="Color.Primary" Type="ButtonType.Link" To="/my-quotes">
            <Icon Name="IconName.AngleLeft" /> My Quotes
        </Button>
        <h2>Delete Quote</h2>
        <div>Are you sure you want to delete this quote? <span class="text-danger">This action cannot be undone.</span>
        </div>
        <br>
        <button class="btn btn-danger" disabled=@DisabledDeleteButton @onclick="Delete">Delete</button>
        <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
    </div>
}

@code {
    [Parameter]
    public string? User { get; set; }
    [Parameter]
    public int? Id { get; set; }
    private SnackbarStack snackbarStack;
    private string? token;
    private bool DisabledDeleteButton = false;

    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
    }
    private async Task Delete()
    {
        DisabledDeleteButton = true;
        var response = await Http.DeleteAsync("/quotes/" + Id);
        if (response.IsSuccessStatusCode)
        {
            await snackbarStack.PushAsync("Quote deleted successfully!", SnackbarColor.Success);
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/my-quotes");
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
            await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
        }
        DisabledDeleteButton = false;
    }
}