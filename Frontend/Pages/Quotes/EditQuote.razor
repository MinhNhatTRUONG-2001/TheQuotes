@page "/my-quotes/edit/{id:int}"

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Edit Quote</PageTitle>

@if (loading)
{
    <Loading />
}
else
{
    @if (string.IsNullOrEmpty(token))
    {
        <h2>You need to login to edit your quotes!</h2>
    }
    else
    {
        <div class="mt-4 mb-2">
            <Button Color="Color.Primary" Type="ButtonType.Link" To="/my-quotes">
                <Icon Name="IconName.AngleLeft" /> My Quotes
            </Button>
            <h2>Edit Quote</h2>
            @if (editedQuote != null)
            {
                <EditForm Model="@editedQuote" OnValidSubmit="@HandleEditQuote">
                    <DataAnnotationsValidator />
                    <div class="form-floating mb-3">
                        <InputText id="floatingQuoteContent" class="form-control" placeholder="Quote Content" required
                            @bind-Value="editedQuote.Quote" />
                        <label for="floatingQuoteContent">Quote Content *</label>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText id="floatingWhoSaid" class="form-control" placeholder="Who Said" required
                            @bind-Value="editedQuote.SaidBy" />
                        <label for="floatingWhoSaid">Who Said *</label>
                    </div>
                    <div class="mb-3">When It Was Said:
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <DatePicker @ref="@datePicker" TValue="DateOnly ?" @bind-Date="@when" />
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <Button Color="Color.Danger" Clicked="@(() => when = null)">
                                    <Icon Name="IconName.Delete" />
                                </Button>
                            </Addon>
                        </Addons>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText id="floatingSource" class="form-control" type="url" placeholder="Source (URL)"
                            @bind-Value="editedQuote.Source" />
                        <label for="floatingSource">Source (URL)</label>
                    </div>
                    <button type="submit" class="btn btn-primary" disabled=@DisabledEditButton>
                        @if (DisabledEditButton)
                        {
                            <Loading />
                        }
                        else
                        {
                            <span>Update</span>
                        }
                    </button>
                </EditForm>
            }
            <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
        </div>
    }
}

@code {
    [Parameter]
    public string? User { get; set; }
    [Parameter]
    public int? Id { get; set; }
    public QuoteDTO? editedQuote;
    DateOnly? when; // for type casting of the "When It Was Said" field
    private SnackbarStack snackbarStack;
    private string? token;
    private bool loading = true;
    private bool DisabledEditButton = false;
    DatePicker<DateOnly?> datePicker;

    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        editedQuote = await Http.GetFromJsonAsync<QuoteDTO>("/quotes/" + Id);
        if (editedQuote != null && editedQuote.When != null)
        {
            when = DateOnly.Parse(editedQuote.When);
        }
        loading = false;
    }
    protected async Task HandleEditQuote()
    {
        DisabledEditButton = true;
        editedQuote.When = when?.ToString("yyyy-MM-dd");
        var response = await Http.PutAsJsonAsync("/quotes/" + Id, editedQuote);
        if (response.IsSuccessStatusCode)
        {
            await snackbarStack.PushAsync("Quote edited successfully!", SnackbarColor.Success);
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/my-quotes");
        }
        else
        {
            string errorMessage = await response.Content.ReadAsStringAsync();
            await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
        }
        DisabledEditButton = false;
    }
}