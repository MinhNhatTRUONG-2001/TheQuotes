@inject IJSRuntime JS
@inject HttpClient Http

<Card Shadow="Shadow.Default" Margin="Margin.Is3.OnY">
    <CardHeader Background="Background.Transparent">
        <div class="d-flex justify-content-between gap-2">
            <div>
                <img src="@(!string.IsNullOrWhiteSpace(Quote.User?.AvatarUrl) ? Quote.User?.AvatarUrl : "blank-avatar.png")" alt="@Quote.User.DisplayedName" style="width: 50px; height: 50px" />
                <a href="@($"/profile/{Quote.User.Id}")"><b>@Quote.User.DisplayedName</b></a> (@Quote.User.Username) &bull; @Quote.CreatedAt
            </div>
            @if (token != null)
            {
                <button class="btn btn-primary" @onclick="ToggleFavourite" disabled="@DisabledFavouriteButton">
                    @if (Quote.Favourite == null) {
                        <span><i class="fa-solid fa-heart"></i> Save</span>
                    }
                    else {
                        <span><i class="fa-regular fa-heart"></i> Unsave</span>
                    }
                </button>
            }
        </div>
    </CardHeader>
    <CardBody>
        <CardText TextAlignment="TextAlignment.Center" Margin="Margin.Is3.OnY">
            <i>"@Quote.Quote"</i>
        </CardText>
        <CardText TextAlignment="TextAlignment.Center">
            @Quote.SaidBy
        </CardText>
        @if (Quote.When != null)
        {
            <CardText TextAlignment="TextAlignment.Center">
                @Quote.When
            </CardText>
        }
        @if (!string.IsNullOrWhiteSpace(Quote.Source))
        {
            <CardText TextAlignment="TextAlignment.Center" Margin="Margin.Is3.OnY">
                <a href="@Quote.Source">View Source</a>
            </CardText>
        }
    </CardBody>
    @if (EditLink != null && DeleteLink != null)
    {
        <CardFooter Background="Background.Transparent" TextAlignment="TextAlignment.Center" Margin="Margin.Is3.FromTop">
            <Button Color="Color.Primary" Type="ButtonType.Link" To=@EditLink><Icon Name="IconName.Edit" /> Edit</Button>
            <Button Color="Color.Danger" Type="ButtonType.Link" To=@DeleteLink><Icon Name="IconName.Delete" /> Delete</Button>
        </CardFooter>
    }
</Card>
<SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />

@code {
    [Parameter]
    public QuoteDTO Quote { get; set; }
    [Parameter]
    public string? EditLink { get; set; }
    [Parameter]
    public string? DeleteLink { get; set; }
    private string? token;
    private SnackbarStack snackbarStack;
    private bool DisabledFavouriteButton = false;

    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
    }
    private async Task ToggleFavourite()
    {
        DisabledFavouriteButton = true;

        try
        {
            if (Quote.Favourite == null)
            {
                var newFavourite = new FavouriteQuoteDTO 
                {
                    QuoteId = Quote.Id,
                };
                var response = await Http.PostAsJsonAsync($"/favourite_quotes", newFavourite);
                if (response.IsSuccessStatusCode)
                {
                    var favourite = await response.Content.ReadFromJsonAsync<FavouriteQuoteDTO>();
                    Quote.Favourite = favourite;
                    await snackbarStack.PushAsync("Quote added to Favourites!", SnackbarColor.Success);
                }
                else
                {
                    var errorMessage = await response.Content.ReadAsStringAsync();
                    await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
                }
            }
            else {
                var response = await Http.DeleteAsync($"/favourite_quotes/{Quote.Favourite.Id}");
                if (response.IsSuccessStatusCode)
                {
                    Quote.Favourite = null;
                    var successMessage = await response.Content.ReadAsStringAsync();
                    await snackbarStack.PushAsync(successMessage, SnackbarColor.Success);
                }
                else
                {
                    var errorMessage = await response.Content.ReadAsStringAsync();
                    await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
                }
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledFavouriteButton = false;
        }
    }
}
