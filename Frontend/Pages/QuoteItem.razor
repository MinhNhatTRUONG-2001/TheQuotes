<Card Shadow="Shadow.Default" Margin="Margin.Is3.OnY">
    <CardHeader Background="Background.Transparent">
        <img src="@(!string.IsNullOrWhiteSpace(Quote.User?.AvatarUrl) ? Quote.User?.AvatarUrl : "blank-avatar.png")" alt="@Quote.User.DisplayedName" style="width: 50px; height: 50px" />
        <b>@Quote.User.DisplayedName</b> (@Quote.User.Username) &bull; @Quote.CreatedAt
    </CardHeader>
    <CardBody>
        <CardText TextAlignment="TextAlignment.Center" Margin="Margin.Is3.OnY">
            <i>"@Quote.Quote"</i>
        </CardText>
        <CardText TextAlignment="TextAlignment.Center">
            @Quote.SaidBy
        </CardText>
        @if (Quote.When != null)
        {
            <CardText TextAlignment="TextAlignment.Center">
                @Quote.When
            </CardText>
        }
        @if (!string.IsNullOrWhiteSpace(Quote.Source))
        {
            <CardText TextAlignment="TextAlignment.Center" Margin="Margin.Is3.OnY">
                <a href="@Quote.Source">View Source</a>
            </CardText>
        }
    </CardBody>
    @if (EditLink != null && DeleteLink != null)
    {
        <CardFooter Background="Background.Transparent" TextAlignment="TextAlignment.Center" Margin="Margin.Is3.FromTop">
            <Button Color="Color.Primary" Type="ButtonType.Link" To=@EditLink><Icon Name="IconName.Edit" /> Edit</Button>
            <Button Color="Color.Danger" Type="ButtonType.Link" To=@DeleteLink><Icon Name="IconName.Delete" /> Delete</Button>
        </CardFooter>
    }
</Card>

@code {
    [Parameter]
    public QuoteDTO Quote { get; set; }
    [Parameter]
    public string? EditLink { get; set; }
    [Parameter]
    public string? DeleteLink { get; set; }
}
