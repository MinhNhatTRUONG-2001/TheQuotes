@page "/my-profile"

@inject HttpClient Http
@inject IJSRuntime JS
@using Frontend.Pages.Quotes

<PageTitle>My Profile</PageTitle>

@if (loading)
{
    <Loading />
}
else
{
    @if (string.IsNullOrEmpty(token))
    {
        <h2>You need to login to view & edit your profile!</h2>
    }
    else
    {
        <div class="text-center mt-4">
            <div class="my-3">
                <InputFile OnChange="HandleSelectedAvatar" accept="image/*" style="display:none" />
                <Tooltip Text="Maximum file size: 3MB<br>Minimum dimension: 200x200px; Maximum dimension: 5000x5000px">
                    <button class="btn btn-primary me-2" @onclick="TriggerAvatarSelect" disabled="@avatarLoading">
                        @(User?.AvatarUrl == null ? "Upload Avatar" : "Change Avatar")
                    </button>
                </Tooltip>
                @if (User?.AvatarUrl != null)
                {
                    <button class="btn btn-danger" @onclick="@ShowDeleteAvatarModal" disabled="@avatarLoading">Delete
                        Avatar</button>
                }
            </div>
            @if (avatarLoading)
            {
                <Loading />
            }
            <img src="@(!string.IsNullOrWhiteSpace(User?.AvatarUrl) ? User.AvatarUrl : "blank-avatar.png")"
                alt="@($"{User?.DisplayedName}'s Avatar")" style="width: 200px; height: 200px;" class="mb-3" />
            <h2>@User?.DisplayedName</h2>
            <div>(@User?.Username)</div>
            <div class="mx-4">@User?.AboutMe</div>
            <div class="text-center mt-2">
                <button class="btn btn-primary" @onclick="ShowEditProfileModal">
                    <Icon Name="IconName.Pen" /> Edit profile
                </button>
                <Button Color="Color.Secondary" Type="ButtonType.Link" To="@($"/profile/{User?.Id}")">
                    <Icon Name="IconName.Eye" /> View profile as guest
                </Button>
            </div>
        </div>
        <Divider />
        <QuoteList />
    }
    <Modal @ref="deleteAvatarModalRef">
        <ModalContent Centered>
            <ModalHeader>
                <ModalTitle>Confirm deleting avatar</ModalTitle>
                <CloseButton />
            </ModalHeader>
            <ModalBody>
                Are you sure you want to delete your avatar? This action cannot be undone.
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="@(() => deleteAvatarModalRef.Hide())">No</Button>
                <Button Color="Color.Primary" Clicked="@DeleteAvatar">Yes</Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
    <Modal @ref="editProfileModalRef" Closed="ResetEditForm">
        <ModalContent Centered Size="ModalSize.Large">
            <ModalHeader>
                <ModalTitle>Edit Profile</ModalTitle>
                <CloseButton />
            </ModalHeader>
            <ModalBody>
                <EditForm Model="UserEdit" OnValidSubmit="UpdateUserInfo">
                    <DataAnnotationsValidator />
                    <div class="form-floating mb-3">
                        <InputText id="floatingDisplayName" class="form-control" placeholder="Displayed Name" required
                            @bind-Value="UserEdit.DisplayedName" />
                        <label for="floatingDisplayName">Displayed Name</label>
                    </div>
                    <div class="form-floating mb-3">
                        <InputTextArea id="floatingAboutMe" class="form-control" placeholder="About Me" style="height: 200px;"
                            @bind-Value="UserEdit.AboutMe" />
                        <label for="floatingAboutMe">About Me</label>
                    </div>
                </EditForm>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="@ResetEditForm">Cancel</Button>
                <Button Color="Color.Primary" Clicked="@UpdateUserInfo" Disabled="@DisabledUpdateButton">
                    @if (DisabledUpdateButton)
                    {
                        <Loading />
                    }
                    else
                    {
                        <span>Update</span>
                    }
                </Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
    <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
}

@code {
    private string? token;
    private bool loading = true;
    private bool avatarLoading = false;
    private UserInfoDTO? User;
    private UserInfoDTO? UserEdit;
    private SnackbarStack snackbarStack;
    private Modal deleteAvatarModalRef;
    private Modal editProfileModalRef;
    private bool DisabledUpdateButton = false;

    private Task ShowDeleteAvatarModal()
    {
        return deleteAvatarModalRef.Show();
    }

    private Task ShowEditProfileModal()
    {
        return editProfileModalRef.Show();
    }

    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
        var request = new HttpRequestMessage(HttpMethod.Get, "users/info");
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            User = await response.Content.ReadFromJsonAsync<UserInfoDTO>();
            UserEdit = new UserInfoDTO
            {
                DisplayedName = User?.DisplayedName,
                AboutMe = User?.AboutMe
            };
        }
        loading = false;
    }

    private async Task TriggerAvatarSelect()
    {
        await JS.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
    }

    private async Task HandleSelectedAvatar(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await UploadAvatar(file);
    }

    private async Task UploadAvatar(IBrowserFile file)
    {
        avatarLoading = true;
        var content = new MultipartFormDataContent();
        Stream? stream;
        long maxAllowedSize = 3 * 1024 * 1024; // 3MB
        try
        {
            stream = file.OpenReadStream(maxAllowedSize);
        }
        catch (Exception)
        {
            await snackbarStack.PushAsync($"File size exceeds the limit of {maxAllowedSize / (1024 * 1024)} MB!",
            SnackbarColor.Danger);
            avatarLoading = false;
            return;
        }
        var streamContent = new StreamContent(stream);
        streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
        content.Add(streamContent, "avatarFile", file.Name);

        var request = new HttpRequestMessage(HttpMethod.Put, "users/change_avatar");
        request.Content = content;
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.SendAsync(request);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadAsStringAsync();
            User!.AvatarUrl = result.Trim('"'); // Avatar URL
            await snackbarStack.PushAsync("Avatar uploaded successfully!", SnackbarColor.Success);
        }
        else
        {
            string errorMessage = await response.Content.ReadAsStringAsync();
            await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
        }

        avatarLoading = false;
        StateHasChanged();
    }

    private async Task DeleteAvatar()
    {
        avatarLoading = true;

        var request = new HttpRequestMessage(HttpMethod.Put, "users/change_avatar"); // sending null avatarFile
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.SendAsync(request);

        if (response.IsSuccessStatusCode)
        {
            User!.AvatarUrl = null;
            await snackbarStack.PushAsync("Avatar deleted.", SnackbarColor.Success);
        }
        else
        {
            string errorMessage = await response.Content.ReadAsStringAsync();
            await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
        }
        avatarLoading = false;
        await deleteAvatarModalRef.Hide();
    }
    private async Task ResetEditForm()
    {
        UserEdit = new UserInfoDTO
        {
            DisplayedName = User?.DisplayedName,
            AboutMe = User?.AboutMe
        };
        await editProfileModalRef.Hide();
    }
    private async Task UpdateUserInfo()
    {
        DisabledUpdateButton = true;
        var request = new HttpRequestMessage(HttpMethod.Put, "users/change_info");
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        request.Content = JsonContent.Create(UserEdit);

        var response = await Http.SendAsync(request);

        if (response.IsSuccessStatusCode)
        {
            if (User != null && UserEdit != null)
            {
                User.DisplayedName = UserEdit.DisplayedName;
                User.AboutMe = UserEdit.AboutMe;
            }
            string successMessage = await response.Content.ReadAsStringAsync();
            await snackbarStack.PushAsync(successMessage, SnackbarColor.Success);
            await editProfileModalRef.Hide();
        }
        else
        {
            string errorMessage = await response.Content.ReadAsStringAsync();
            await snackbarStack.PushAsync(errorMessage, SnackbarColor.Danger);
        }
        DisabledUpdateButton = false;
    }
}