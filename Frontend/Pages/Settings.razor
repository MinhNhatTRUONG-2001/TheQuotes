@page "/account-settings"

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
@inject NavigationManager NavigationManager

<PageTitle>Account Settings</PageTitle>

@if (loading)
{
    <Loading />
}
else
{
    @if (string.IsNullOrEmpty(token))
    {
        <h2>You need to login to manage your account!</h2>
    }
    else
    {
        <div class="mt-4">
            <Accordion>
                <AccordionItem>
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is5">
                            <AccordionToggle>Change password</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        <EditForm Model="User" OnValidSubmit="HandlePasswordChange">
                            <DataAnnotationsValidator />
                            <div class="form-floating mb-3">
                                <InputText id="floatingCurrentPassword" type="@(showPassword ? "text" : "password")"
                                    class="form-control" placeholder="Current Password" required
                                    @bind-Value="User.CurrentPassword" />
                                <label for="floatingCurrentPassword">Current Password</label>
                            </div>
                            <div class="form-floating mb-3">
                                <InputText id="floatingPassword" type="@(showPassword ? "text" : "password")"
                                    class="form-control" placeholder="Password" required @bind-Value="User.Password" />
                                <label for="floatingPassword">Password</label>
                            </div>
                            <div class="form-floating mb-3">
                                <InputText id="floatingRetypePassword" type="@(showPassword ? "text" : "password")"
                                    class="form-control" placeholder="Retype Password" required
                                    @bind-Value="User.RetypePassword" />
                                <label for="floatingRetypePassword">Retype Password</label>
                            </div>
                            <Switch TValue="bool" @bind-Checked="@showPassword">Show Password</Switch>
                            <strong>Password rule:</strong>
                            <ul>
                                <li>Between 8-64 characters</li>
                                <li>At least one lowercase letter</li>
                                <li>At least one uppercase letter</li>
                                <li>At least one digit</li>
                                <li>At least one special letter</li>
                            </ul>
                            <button type="submit" class="btn btn-primary" disabled=@DisabledUpdateButton>
                                @if (DisabledUpdateButton)
                                {
                                    <Loading />
                                }
                                else
                                {
                                    <span>Update</span>
                                }
                            </button>
                        </EditForm>
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem>
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is5">
                            <AccordionToggle>Delete Account</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        <div class="mb-2">Be careful! If you do this, you will lose all data in your account.</div>
                        <button type="submit" class="btn btn-danger" @onclick="ShowModal">Delete Account</button>
                    </AccordionBody>
                </AccordionItem>
            </Accordion>
        </div>
    }
    <Modal @ref="deleteAccountModalRef">
        <ModalContent Centered>
            <ModalHeader>
                <ModalTitle>Confirm deleting account</ModalTitle>
                <CloseButton />
            </ModalHeader>
            <ModalBody>
                <div class="mb-2">To delete your account, type your account password into the field below.</div>
                <div class="form-floating mb-3">
                    <InputText id="floatingPassword" type="@(showPassword2 ? "text" : "password")" class="form-control"
                        placeholder="Password" required @bind-Value="User2.Password" />
                    <label for="floatingPassword">Password</label>
                </div>
                <Switch TValue="bool" @bind-Checked="@showPassword2">Show Password</Switch>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="@(() => deleteAccountModalRef.Hide())">Cancel</Button>
                <Button Color="Color.Danger" Clicked="@HandleDeleteAccount" Disabled="@DisabledDeleteButton">
                    @if (DisabledDeleteButton)
                    {
                        <Loading />
                    }
                    else
                    {
                        <span>Delete</span>
                    }
                </Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
    <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
}

@code {
    private string? token;
    private bool loading = true;
    private UserDTO User = new UserDTO();
    private UserDTO User2 = new UserDTO();
    private SnackbarStack snackbarStack;
    private bool showPassword = false;
    private bool showPassword2 = false;
    private string SuccessMessage = "";
    private string ErrorMessage = "";
    private bool DisabledUpdateButton = false;
    private bool DisabledDeleteButton = false;
    private Modal deleteAccountModalRef;

    private Task ShowModal()
    {
        return deleteAccountModalRef.Show();
    }

    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        loading = false;
    }
    private async Task HandlePasswordChange()
    {
        DisabledUpdateButton = true;
        try
        {
            if (User.Password != User.RetypePassword)
            {
                await snackbarStack.PushAsync("Passwords do not match!", SnackbarColor.Danger);
            }
            else
            {
                var response = await Http.PutAsJsonAsync("users/change_password", User);
                if (response.IsSuccessStatusCode)
                {
                    User = new UserDTO();
                    SuccessMessage = response.Content.ReadAsStringAsync().Result;
                    await snackbarStack.PushAsync(SuccessMessage, SnackbarColor.Success);
                }
                else
                {
                    ErrorMessage = response.Content.ReadAsStringAsync().Result;
                    await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
                }
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledUpdateButton = false;
        }
    }
    private async Task HandleDeleteAccount()
    {
        DisabledDeleteButton = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, "users")
            {
                Content = JsonContent.Create(User2)
            };
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                await snackbarStack.PushAsync("Account deleted successfully!", SnackbarColor.Success);
                await Task.Delay(1000);
                TokenService.SetToken(null);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ErrorMessage = response.Content.ReadAsStringAsync().Result;
                await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledDeleteButton = false;
        }
    }
}