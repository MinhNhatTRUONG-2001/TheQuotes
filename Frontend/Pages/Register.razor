@page "/register"
@inject NavigationManager NavigationManager
@inject HttpClient Http
@using System.Net.Http.Json
@inject IJSRuntime JS

<PageTitle>Register</PageTitle>

@if (!string.IsNullOrEmpty(token))
{
    <h2>You need to logout before registering!</h2>
}
else
{
    <div class="mt-4 mb-2">
        <h3>Register</h3>
        <EditForm Model="User" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText id="floatingUsername" class="form-control" placeholder="Username" required @bind-Value="User.Username" />
                <label for="floatingUsername">Username</label>
            </div>
            <div class="form-floating mb-3">
                <InputText id="floatingEmail" class="form-control" type="email" placeholder="Email" required @bind-Value="User.Email" />
                <label for="floatingEmail">Email</label>
            </div>
            <div class="form-floating mb-3">
                <InputText id="floatingDisplayedName" class="form-control" placeholder="Displayed Name" required @bind-Value="User.DisplayedName" />
                <label for="floatingDisplayedName">Displayed Name</label>
            </div>
            <div class="form-floating mb-3">
                <InputText id="floatingPassword" type="@(showPassword ? "text" : "password")" class="form-control"
                    placeholder="Password" required @bind-Value="User.Password" />
                <label for="floatingPassword">Password</label>
            </div>
            <div class="form-floating mb-3">
                <InputText id="floatingRetypePassword" type="@(showPassword ? "text" : "password")" class="form-control"
                    placeholder="Retype Password" required @bind-Value="User.RetypePassword" />
                <label for="floatingRetypePassword">Retype Password</label>
            </div>
            <Check TValue="bool" @bind-Checked="@showPassword">Show Password</Check>
            <br>
            <button type="submit" class="btn btn-primary" disabled=@DisabledRegisterButton>
                @if (DisabledRegisterButton)
                {
                    <Loading />
                }
                else
                {
                    <span>Register</span>
                }
            </button>
        </EditForm>
        <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
    </div>
}

@code {
    private UserDTO User = new UserDTO();
    private SnackbarStack snackbarStack;
    private bool showPassword = false;
    private string? ErrorMessage;
    private bool DisabledRegisterButton = false;
    private string? token;
    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
    }

    private async Task HandleRegister()
    {
        DisabledRegisterButton = true;
        try
        {
            if (User.Password != User.RetypePassword)
            {
                await snackbarStack.PushAsync("Passwords do not match!", SnackbarColor.Danger);
            }
            else
            {
                var response = await Http.PostAsJsonAsync("users/register", User);
                if (response.IsSuccessStatusCode)
                {
                    var token = response.Content.ReadAsStringAsync().Result;
                    await JS.InvokeVoidAsync("cookieManager.setCookie", "token", token, 1);
                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    ErrorMessage = response.Content.ReadAsStringAsync().Result;
                    await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
                }
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledRegisterButton = false;
        }
    }
}