@inject NavigationManager NavigationManager
@using Blazorise.Snackbar
@inject HttpClient Http
@inject IJSRuntime JS

@page "/login"

<PageTitle>Login</PageTitle>

@if (!string.IsNullOrEmpty(token))
{
    <h2>You have already logged in!</h2>
}
else
{
    <div class="mt-4 mb-2">
        <h2>Login</h2>
        <TextEdit Placeholder="Username" @bind-Text="@User.Username" />
        <br>
        <TextEdit Placeholder="Password" Role="showPassword? TextRole.Text: TextRole.Password" @bind-Text="@User.Password" />
        <br>
        <Check TValue="bool" @bind-Checked="@showPassword">Show Password</Check>
        <br>
        <Button Color="Color.Primary" Clicked="@HandleValidSubmit" Disabled="@DisabledLoginButton">Login</Button>
        <br>
        <SnackbarStack @ref="snackbarStack" Location="SnackbarStackLocation.BottomEnd" DefaultInterval="3000" />
    </div>
}

@code {
    private UserDTO User = new UserDTO();
    private SnackbarStack snackbarStack;
    private bool showPassword = false;
    private string ErrorMessage = "";
    private bool DisabledLoginButton = false;
    private string? token;
    protected override async Task OnInitializedAsync()
    {
        token = await JS.InvokeAsync<string>("cookieManager.getCookie", "token");
    }
    protected async Task HandleValidSubmit()
    {
        DisabledLoginButton = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/users/login", User);
            if (response.IsSuccessStatusCode)
            {
                var token = response.Content.ReadAsStringAsync().Result;
                await JS.InvokeVoidAsync("cookieManager.setCookie", "token", token, 1);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ErrorMessage = response.Content.ReadAsStringAsync().Result;
                await snackbarStack.PushAsync(ErrorMessage, SnackbarColor.Danger);
            }
        }
        catch (Exception ex)
        {
            await snackbarStack.PushAsync(ex.Message, SnackbarColor.Danger);
        }
        finally
        {
            DisabledLoginButton = false;
        }
    }
}